{
  "name": "tumblr-tags",
  "version": "1.0.3",
  "description": "Parse all tags used in the posts of a Tumblr blog. Library + ttags CLI.",
  "keywords": [
    "tumblr",
    "tags",
    "tag-cloud",
    "tagcloud",
    "cli",
    "esm",
    "static-site"
  ],
  "homepage": "https://github.com/romanyanke/tumblr-tags#readme",
  "bugs": {
    "url": "https://github.com/romanyanke/tumblr-tags/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romanyanke/tumblr-tags.git"
  },
  "license": "ISC",
  "author": "Roman Yanke <roman@yanke.ru>",
  "main": "lib/src/index.js",
  "typings": "./lib/src/index.d.ts",
  "bin": {
    "ttags": "./lib/src/cli.js"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "clean": "rm -rf lib dist coverage *.tsbuildinfo",
    "build": "npm run clean && tsc --build && tsc --declaration --outDir lib",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:pack": "publint --strict && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^24.13.4",
    "@vitest/coverage-v8": "^5.0.0",
    "publint": "^0.3.24",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
