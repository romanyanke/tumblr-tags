{
  "name": "tumblr-tags",
  "version": "1.0.3",
  "description": "Parse all tags used in the posts of a Tumblr blog. Library + ttags CLI.",
  "keywords": [
    "tumblr",
    "tags",
    "tag-cloud",
    "tagcloud",
    "cli",
    "esm",
    "static-site"
  ],
  "homepage": "https://github.com/romanyanke/tumblr-tags#readme",
  "bugs": {
    "url": "https://github.com/romanyanke/tumblr-tags/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romanyanke/tumblr-tags.git"
  },
  "license": "ISC",
  "author": "Roman Yanke <roman@yanke.ru>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "ttags": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "rm -rf dist coverage *.tsbuildinfo",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:pack": "publint --strict && attw --pack . --profile esm-only",
    "cli": "node dist/cli.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^24.13.4",
    "@vitest/coverage-v8": "^5.0.0",
    "publint": "^0.3.24",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
